model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

ref table '_Measures'
ref table 'Sales'
ref table 'Returns'
ref table 'Customer'
ref table 'Product'
ref table 'Calendar'
ref table 'Geography'
ref table 'Segment'
ref table 'Month Index'
ref table 'Data Quality Log'

