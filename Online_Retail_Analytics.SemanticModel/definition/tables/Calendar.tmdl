/// Dimension: date table (marked as date table)
table 'Calendar'
	dataCategory: Time

	column 'Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		isKey
		summarizeBy: none
		sourceColumn: Date

	column 'Year'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column 'Quarter'
		dataType: string
		summarizeBy: none
		sourceColumn: Quarter

	column 'MonthNum'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: MonthNum

	column 'Month'
		dataType: string
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'MonthNum'

	column 'MonthStart'
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: MonthStart

	column 'YearMonth'
		dataType: string
		summarizeBy: none
		sourceColumn: YearMonth
		sortByColumn: 'YearMonthKey'

	column 'MonthShort'
		dataType: string
		summarizeBy: none
		sourceColumn: MonthShort
		sortByColumn: 'YearMonthKey'

	column 'YearMonthKey'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: YearMonthKey

	column 'WeekdayNum'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: WeekdayNum

	column 'Weekday'
		dataType: string
		summarizeBy: none
		sourceColumn: Weekday
		sortByColumn: 'WeekdayNum'

	column 'HasSales'
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: HasSales

	partition 'Calendar' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"MonthNum", Int64.Type}, {"Month", type text}, {"MonthStart", type date}, {"YearMonth", type text}, {"MonthShort", type text}, {"YearMonthKey", Int64.Type}, {"WeekdayNum", Int64.Type}, {"Weekday", type text}, {"HasSales", type logical}}, "en-US")
				in
				    Typed

