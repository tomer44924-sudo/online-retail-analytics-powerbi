/// Dimension: months since first purchase (cohort analysis)
table 'Month Index'

	column 'MonthIndex'
		dataType: int64
		formatString: 0
		isKey
		summarizeBy: none
		sourceColumn: MonthIndex

	column 'MonthLabel'
		dataType: string
		summarizeBy: none
		sourceColumn: MonthLabel
		sortByColumn: 'MonthIndex'

	partition 'Month Index' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_month_index.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"MonthIndex", Int64.Type}, {"MonthLabel", type text}}, "en-US")
				in
				    Typed

